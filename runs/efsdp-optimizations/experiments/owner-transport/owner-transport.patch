+"""Task-only EP4 transport for BF16-rounded direct expert gradients."""
+
+import logging
+import os
+from collections.abc import Callable
+
+import torch
+import torch.distributed as dist
+import triton
+import triton.language as tl
+from torch.profiler import record_function
+
+TORCH_REVISION = "8b353065ce260336c5fdfa74d754e8bd9b91b062"
+NCCL_REVISION = (2, 30, 7)
+OWNER_SHAPES = ((32, 3072, 4096), (32, 4096, 1536))
+OWNER_ELEMENTS = 301_989_888
+FQNS = tuple(f"layers.{index}[efsdp]" for index in range(7, 0, -1))
+logger = logging.getLogger("gfsdp")
+
+
+@triton.jit
+def _add_owner_chunk(local, peer, destination, n, block: tl.constexpr):
+    index = tl.program_id(0) * block + tl.arange(0, block)
+    local_value = tl.load(local + index, index < n, other=0)
+    peer_value = tl.load(peer + index, index < n, other=0).to(tl.float32)
+    total = tl.inline_asm_elementwise(
+        "add.rn.f32 $0, $1, $2;",
+        constraints="=f,f,f",
+        args=[local_value, peer_value],
+        dtype=tl.float32,
+        is_pure=True,
+        pack=1,
+    )
+    tl.store(destination + index, total, index < n)
+
+
+def require_recipe(dims, parallelism, training) -> None:
+    if (
+        (dims.world_size, dims.ep, dims.dp_shard, dims.dp_replicate) != (8, 4, 8, 1)
+        or (dims.tp, dims.pp, dims.cp) != (1, 1, 1)
+        or parallelism.fsdp_backend != "gfsdp2"
+        or not (
+            parallelism.gfsdp_fp8_expert_weights
+            and parallelism.gfsdp_direct_expert_dw
+            and parallelism.gfsdp_retain_tail_weights
+        )
+        or parallelism.enable_fsdp_symm_mem
+        or (training.mixed_precision_param, training.mixed_precision_reduce)
+        != ("bfloat16", "float32")
+        or training.enable_cpu_offload
+        or (training.local_batch_size, training.global_batch_size, training.seq_len)
+        != (2, 512, 4096)
+    ):
+        raise RuntimeError("BF16 owner transport requires the pinned native EP4 recipe")
+
+
+def require_runtime(device: torch.device, group: dist.ProcessGroup) -> None:
+    if (
+        torch.version.git_version != TORCH_REVISION
+        or torch.cuda.nccl.version() != NCCL_REVISION
+        or device.type != "cuda"
+        or torch.cuda.get_device_capability(device) != (9, 0)
+        or "H100" not in torch.cuda.get_device_name(device)
+        or group.size() != 2
+        or dist.get_backend(group) != "nccl"
+        or os.environ.get("TORCH_NCCL_NAN_CHECK", "").strip().lower()
+        not in ("", "0", "false")
+    ):
+        raise RuntimeError(
+            "BF16 owner transport requires pinned H100/NCCL eFSDP2 with the NaN check off"
+        )
+
+
+class ExpertOwnerTransport:
+    """One scratch tensor, one process group and one static reduction order."""
+
+    def __init__(
+        self,
+        group: dist.ProcessGroup,
+        device: torch.device,
+        stream: torch.cuda.Stream,
+        is_last_backward: Callable[[], bool],
+    ) -> None:
+        require_runtime(device, group)
+        self.group = group
+        self.rank = group.rank()
+        self.stream = stream
+        self.is_last_backward = is_last_backward
+        self.index = 0
+        self.chunk = OWNER_ELEMENTS // 2
+        self.splits = [0, self.chunk] if self.rank == 0 else [self.chunk, 0]
+        with torch.cuda.stream(stream):
+            self.send = torch.empty(self.chunk, device=device, dtype=torch.bfloat16)
+
+    def finish_backward(self) -> None:
+        expected = len(FQNS) if self.is_last_backward() else 0
+        if self.index != expected:
+            raise RuntimeError(
+                f"BF16 owner transport completed {self.index} of {expected} expert reductions"
+            )
+        self.index = 0
+
+    def reduce(
+        self,
+        fqn: str,
+        slot: torch.Tensor,
+        output: torch.Tensor,
+        group: dist.ProcessGroup,
+        stream: torch.cuda.Stream,
+    ) -> None:
+        if (
+            not self.is_last_backward()
+            or self.index >= len(FQNS)
+            or fqn != FQNS[self.index]
+        ):
+            raise RuntimeError(
+                f"Unexpected BF16 owner transport order at {fqn}, index {self.index}"
+            )
+        if (
+            group is not self.group
+            or stream != self.stream
+            or slot.shape != (2 * OWNER_ELEMENTS,)
+            or output.shape != (OWNER_ELEMENTS,)
+            or slot.dtype != torch.float32
+            or output.dtype != torch.float32
+            or slot.device != self.send.device
+            or output.device != slot.device
+            or not slot.is_contiguous()
+            or not output.is_contiguous()
+        ):
+            raise RuntimeError(f"Invalid BF16 owner transport storage at {fqn}")
+
+        own, other = slot.chunk(2) if self.rank == 0 else tuple(reversed(slot.chunk(2)))
+        if (
+            output.untyped_storage().data_ptr() == slot.untyped_storage().data_ptr()
+            and (output.data_ptr() != own.data_ptr())
+        ):
+            raise RuntimeError(f"BF16 owner output overlaps the peer input at {fqn}")
+
+        with record_function(f"GFSDP::bf16_owner_reduce ({fqn})"):
+            for offset in (0, self.chunk):
+                peer_input = other.narrow(0, offset, self.chunk)
+                self.send.copy_(peer_input)
+                # The complete outgoing contribution is already in the disjoint
+                # send buffer. Only this peer chunk may now be overwritten.
+                receive = peer_input.view(torch.bfloat16)[: self.chunk]
+                dist.all_to_all_single(
+                    receive,
+                    self.send,
+                    output_split_sizes=self.splits,
+                    input_split_sizes=self.splits,
+                    group=group,
+                    async_op=False,
+                )
+                _add_owner_chunk[(triton.cdiv(self.chunk, 1024),)](
+                    own.narrow(0, offset, self.chunk),
+                    receive,
+                    output.narrow(0, offset, self.chunk),
+                    self.chunk,
+                    1024,
+                )
+        self.index += 1
+
+
+def bind_expert_owner_transport(groups, comm, is_last_backward):
+    chosen = [group for group in groups if group._direct_expert_dw_requested]
+    by_name = {group._module_fqn: group for group in chosen}
+    if len(chosen) != len(FQNS) or set(by_name) != set(FQNS):
+        raise RuntimeError(
+            "BF16 owner transport requires exactly the seven pinned expert groups"
+        )
+    first = by_name[FQNS[0]]
+    process_group = first._reduce_scatter_process_group
+    # Each pair is one eFSDP shard group on the eight-rank EP4 mesh.
+    base_rank = dist.get_rank() % 4
+    if (
+        dist.get_process_group_ranks(process_group) != [base_rank, base_rank + 4]
+        or comm.reduce_scatter_stream != comm.all_gather_stream
+        or not comm.retain_tail_weights
+    ):
+        raise RuntimeError(
+            "BF16 owner transport requires the pinned mesh and shared communication stream"
+        )
+    for group in chosen:
+        slot = group._direct_expert_dw_slot
+        if (
+            group.comm_ctx is not comm
+            or group._fp8_cache is None
+            or group._bf16_cache_enabled
+            or group._direct_expert_dw_shapes != OWNER_SHAPES
+            or slot is None
+            or slot.numel() != 2 * OWNER_ELEMENTS
+            or slot is not group._reduce_scatter_input.get(None)
+            or group._reduce_scatter_process_group is not process_group
+            or group._all_reduce_process_group is not None
+            or group.grad_buffer_ctx is None
+            or group.grad_buffer_ctx.yccl_handles.get(None) is not None
+            or (group.orig_dtype, group.param_dtype, group.reduce_dtype)
+            != (torch.float32, torch.bfloat16, torch.float32)
+            or not group.reduce_grads
+            or group.gradient_divide_factor != 1.0
+            or group.force_sum_reduction_for_comms
+            or group.mp_policy.bit32_acc_for_bit16_reduce_scatter
+        ):
+            raise RuntimeError(
+                f"Invalid BF16 owner transport guard at {group._module_fqn}"
+            )
+    transport = ExpertOwnerTransport(
+        process_group, first.device, comm.reduce_scatter_stream, is_last_backward
+    )
+    for group in chosen:
+        group._owner_transport = transport
+    logger.info("GFSDP BF16 owner transport active: %s", ", ".join(FQNS))
+    return transport
