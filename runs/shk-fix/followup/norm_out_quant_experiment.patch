+@dsl_user_op
+def _pack_fp8(v0, v1, v2, v3, scale, *, loc=None, ip=None):
+    return cutlass.Int32(
+        llvm.inline_asm(
+            cutlass.Int32.mlir_type,
+            [F32(v).ir_value(loc=loc, ip=ip) for v in (v0, v1, v2, v3, scale)],
+            """{
+                .reg .f32 scaled<4>, inv;
+                .reg .b16 lo, hi;
+                rcp.approx.ftz.f32 inv, $5;
+                mul.rn.ftz.f32 scaled0, $1, inv;
+                mul.rn.ftz.f32 scaled1, $2, inv;
+                mul.rn.ftz.f32 scaled2, $3, inv;
+                mul.rn.ftz.f32 scaled3, $4, inv;
+                cvt.rn.satfinite.e4m3x2.f32 lo, scaled1, scaled0;
+                cvt.rn.satfinite.e4m3x2.f32 hi, scaled3, scaled2;
+                mov.b32 $0, {lo, hi};
+            }""",
+            "=r,f,f,f,f,f",
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    )
