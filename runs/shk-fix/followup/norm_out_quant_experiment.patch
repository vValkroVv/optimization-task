+def compile_norm_out_quant(eps, lgw, *, compile_kernel=compile_op):
+    """Compile the ordinary native output phase and its 1x128 quantization."""
+    hidden, rank, sms, chunks = 4096, 16, 116, 4
+    splits = pick_n_split(hidden)
+    stages = pick_f2_stages(hidden, chunks)
+    m = cute.sym_int(width=64)
+    output_phase = GnFwdOut(
+        hidden, rank, splits, chunks, eps, lgw, sms, stages, quantize_output=True
+    )
+
+    @cute.jit
+    def launch(
+        x: cute.Tensor,
+        weight: cute.Tensor,
+        down: cute.Tensor,
+        p_part: cute.Tensor,
+        ss_part: cute.Tensor,
+        y: cute.Tensor,
+        rho: cute.Tensor,
+        p: cute.Tensor,
+        words: cute.Tensor,
+        scale: cute.Tensor,
+        stream: cuda.CUstream,
+    ):
+        output_phase(x, weight, down, p_part, ss_part, y, rho, p, x, stream, words, scale)
+
+    return compile_kernel(
+        ("f2_row_quant", hidden, rank, splits, chunks, eps, lgw, sms, stages),
+        lambda: launch,
+        (
+            make_fake_compact_tensor(
+                BF16, (m, hidden), stride_order=(1, 0), assumed_align=16
+            ),
+            make_fake_compact_tensor(F32, (hidden,), stride_order=(0,), assumed_align=16),
+            make_fake_compact_tensor(
