+@dsl_user_op
+def _quant_scale(v0, v1, v2, v3, *, loc=None, ip=None):
+    """CudaCherry d3e0feb row scale, from one warp's 128 BF16 values."""
+    return F32(
+        llvm.inline_asm(
+            F32.mlir_type,
+            [F32(v).ir_value(loc=loc, ip=ip) for v in (v0, v1, v2, v3)],
+            """{
+                .reg .f32 a<4>, mx, other;
+                .reg .b32 bits, shuffled, mantissa;
+                .reg .pred needs_round;
+                abs.f32 a0, $1;
+                abs.f32 a1, $2;
+                abs.f32 a2, $3;
+                abs.f32 a3, $4;
+                max.f32 a0, a0, a1;
+                max.f32 a2, a2, a3;
+                max.f32 mx, a0, a2;
+                mov.b32 bits, mx;
+                shfl.sync.bfly.b32 shuffled, bits, 16, 31, 0xffffffff;
+                mov.b32 other, shuffled;
+                max.f32 mx, mx, other;
+                mov.b32 bits, mx;
+                shfl.sync.bfly.b32 shuffled, bits, 8, 31, 0xffffffff;
+                mov.b32 other, shuffled;
+                max.f32 mx, mx, other;
+                mov.b32 bits, mx;
+                shfl.sync.bfly.b32 shuffled, bits, 4, 31, 0xffffffff;
+                mov.b32 other, shuffled;
+                max.f32 mx, mx, other;
+                mov.b32 bits, mx;
+                shfl.sync.bfly.b32 shuffled, bits, 2, 31, 0xffffffff;
+                mov.b32 other, shuffled;
+                max.f32 mx, mx, other;
+                mov.b32 bits, mx;
+                shfl.sync.bfly.b32 shuffled, bits, 1, 31, 0xffffffff;
+                mov.b32 other, shuffled;
+                max.f32 mx, mx, other;
+
+                // NVCC's FP32 multiply by 1/448 and the 1e-30 scale floor.
+                // max.f32 ignores a lone NaN, including an all-NaN group's
+                // reduction when it meets the floor here.
+                mul.rn.ftz.f32 mx, mx, 0f3B124925;
+                max.f32 mx, mx, 0f0DA24260;
+                mov.b32 bits, mx;
+                and.b32 mantissa, bits, 0x007fffff;
+                setp.ne.u32 needs_round, mantissa, 0;
+                and.b32 bits, bits, 0x7f800000;
+                @needs_round add.u32 bits, bits, 0x00800000;
+                mov.b32 $0, bits;
+            }""",
+            "=f,f,f,f,f",
+            has_side_effects=True,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    )
+
