+@dsl_user_op
+def _cluster_read(ptr, rank, dtype, *, loc=None, ip=None):
+    if dtype is BF16:
+        result_type, ptx_type, constraint = cutlass.Int16.mlir_type, "b16", "h"
+    else:
+        result_type, ptx_type, constraint = F32.mlir_type, "f32", "f"
+    value = llvm.inline_asm(
+        result_type,
+        [
+            ptr.toint(loc=loc, ip=ip).ir_value(loc=loc, ip=ip),
+            cutlass.Int32(rank).ir_value(loc=loc, ip=ip),
+        ],
+        f"""{{ .reg .u32 remote_addr;
+            mapa.shared::cluster.u32 remote_addr, $1, $2;
+            ld.shared::cluster.{ptx_type} $0, [remote_addr]; }}""",
+        f"={constraint},r,r,~{{memory}}",
+        has_side_effects=True,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+    if dtype is BF16:
+        value = llvm.bitcast(BF16.mlir_type, value, loc=loc, ip=ip)
+    return dtype(value)
