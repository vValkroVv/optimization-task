--- a/gift/torchtitan/models/common/norms/cute_gated_norm/forward.py
+++ b/gift/torchtitan/models/common/norms/cute_gated_norm/forward.py
@@ -821,6 +821,526 @@
             store_ring.producer_tail()
 
 
+class GnFwdOutWithNextStats(GnFwdOut):
+    """Stream the next norm's split-K statistics from this residual output stage."""
+
+    @cute.jit
+    def __call__(
+        self,
+        mX: cute.Tensor,
+        mW: cute.Tensor,
+        mGD: cute.Tensor,
+        mPp: cute.Tensor,
+        mSSp: cute.Tensor,
+        mY: cute.Tensor,
+        mRho: cute.Tensor,
+        mP: cute.Tensor,
+        mResidual: cute.Tensor,
+        mNextW: cute.Tensor,
+        mNextPp: cute.Tensor,
+        mNextSSp: cute.Tensor,
+        stream: cuda.CUstream,
+    ):
+        tile_mnk = (BLK_M, BLK_H, self.R)
+        mma = sm90_utils.make_trivial_tiled_mma(
+            BF16,
+            BF16,
+            ROW.sm90_mma_major_mode(),
+            ROW.sm90_mma_major_mode(),
+            F32,
+            (1, 1, 1),
+            tiler_mn=(BLK_M, BLK_H),
+        )
+        next_mma = sm90_utils.make_trivial_tiled_mma(
+            BF16,
+            BF16,
+            ROW.sm90_mma_major_mode(),
+            ROW.sm90_mma_major_mode(),
+            F32,
+            (1, 1, 1),
+            tiler_mn=(BLK_M, self.R),
+        )
+        next_w_l = sm90_utils.make_smem_layout_b(
+            ROW, (BLK_M, self.R, BLK_H), BF16, self.stages
+        )
+        s_l = sm90_utils.make_smem_layout_a(ROW, tile_mnk, BF16, 1)  # S: A, 64 x 16
+        b_l = sm90_utils.make_smem_layout_b(
+            ROW, tile_mnk, BF16, self.stages
+        )  # W_down: B, 64 x 16
+        x_l = sm90_utils.make_smem_layout_epi(BF16, ROW, (BLK_M, BLK_H), self.stages)
+        y_l = sm90_utils.make_smem_layout_epi(
+            BF16, ROW, (BLK_M, BLK_H), 2 * self.epi_stage
+        )
+        tma_x, tX = cpasync.make_tiled_tma_atom(
+            cpasync.CopyBulkTensorTileG2SOp(),
+            mX,
+            cute.slice_(x_l, (None, None, 0)),
+            (BLK_M, BLK_H),
+        )
+        tma_b, tGD = cpasync.make_tiled_tma_atom(
+            cpasync.CopyBulkTensorTileG2SOp(),
+            mGD,
+            cute.slice_(b_l, (None, None, 0)),
+            (BLK_H, self.R),
+        )
+        tma_y, tY = cpasync.make_tiled_tma_atom(
+            cpasync.CopyBulkTensorTileS2GOp(),
+            mY,
+            cute.slice_(y_l, (None, None, 0)),
+            (BLK_M, BLK_H),
+        )
+        tma_residual, tResidual = cpasync.make_tiled_tma_atom(
+            cpasync.CopyBulkTensorTileG2SOp(),
+            mResidual,
+            cute.slice_(x_l, (None, None, 0)),
+            (BLK_M, BLK_H),
+        )
+        tma_next_w, tNextW = cpasync.make_tiled_tma_atom(
+            cpasync.CopyBulkTensorTileG2SOp(),
+            mNextW,
+            cute.slice_(next_w_l, (None, None, 0)),
+            (self.R, BLK_H),
+        )
+        next_red_words = BLK_M * self.R + WG
+
+        @cute.struct
+        class SharedStorage:
+            mbar: cute.struct.MemRange[cutlass.Int64, self.stages * 2]
+            s_x: cute.struct.Align[cute.struct.MemRange[BF16, cute.cosize(x_l)], 1024]
+            s_residual: cute.struct.Align[
+                cute.struct.MemRange[BF16, cute.cosize(x_l)], 1024
+            ]
+            s_b: cute.struct.Align[cute.struct.MemRange[BF16, cute.cosize(b_l)], 1024]
+            s_next_w: cute.struct.Align[
+                cute.struct.MemRange[BF16, cute.cosize(next_w_l)], 1024
+            ]
+            s_y: cute.struct.Align[cute.struct.MemRange[BF16, cute.cosize(y_l)], 1024]
+            s_s: cute.struct.Align[cute.struct.MemRange[BF16, cute.cosize(s_l)], 1024]
+            s_w: cute.struct.Align[cute.struct.MemRange[F32, self.Hc], 16]
+            s_rho: cute.struct.Align[cute.struct.MemRange[F32, BLK_M], 16]
+            s_next_red: cute.struct.Align[cute.struct.MemRange[F32, next_red_words], 16]
+
+        self.shared_storage = SharedStorage
+        M = cutlass.Int64(mX.shape[0])
+        num_tiles = (M + BLK_M - 1) // BLK_M * self.n_hc
+        self.kernel(
+            tma_x,
+            tX,
+            tma_b,
+            tGD,
+            tma_y,
+            tY,
+            tma_residual,
+            tResidual,
+            tma_next_w,
+            tNextW,
+            mNextPp,
+            mNextSSp,
+            mW,
+            mPp,
+            mSSp,
+            mRho,
+            mP,
+            mma,
+            next_mma,
+            x_l,
+            b_l,
+            y_l,
+            s_l,
+            next_w_l,
+            M,
+            num_tiles,
+        ).launch(
+            grid=(self.num_sms, 1, 1),
+            block=(3 * WG, 1, 1),
+            min_blocks_per_mp=1,
+            stream=stream,
+        )
+
+    @cute.kernel
+    def kernel(
+        self,
+        tma_x: cute.CopyAtom,
+        mX: cute.Tensor,
+        tma_b: cute.CopyAtom,
+        mGD: cute.Tensor,
+        tma_y: cute.CopyAtom,
+        mY: cute.Tensor,
+        tma_residual: cute.CopyAtom,
+        mResidual: cute.Tensor,
+        tma_next_w: cute.CopyAtom,
+        mNextW: cute.Tensor,
+        mNextPp: cute.Tensor,
+        mNextSSp: cute.Tensor,
+        mW: cute.Tensor,
+        mPp: cute.Tensor,
+        mSSp: cute.Tensor,
+        mRho: cute.Tensor,
+        mP: cute.Tensor,
+        mma: cute.TiledMma,
+        next_mma: cute.TiledMma,
+        x_l: cute.ComposedLayout,
+        b_l: cute.ComposedLayout,
+        y_l: cute.ComposedLayout,
+        s_l: cute.ComposedLayout,
+        next_w_l: cute.ComposedLayout,
+        M: cutlass.Int64,
+        num_tiles: cutlass.Int64,
+    ):
+        tidx, _, _ = cute.arch.thread_idx()
+        bidx, _, _ = cute.arch.block_idx()
+        gdim, _, _ = cute.arch.grid_dim()
+        warp_idx = cute.arch.make_warp_uniform(cute.arch.warp_idx())
+        wg_idx = cute.arch.make_warp_uniform(tidx // WG)
+        if warp_idx == 0:
+            cpasync.prefetch_descriptor(tma_x)
+            cpasync.prefetch_descriptor(tma_b)
+            cpasync.prefetch_descriptor(tma_y)
+            cpasync.prefetch_descriptor(tma_residual)
+            cpasync.prefetch_descriptor(tma_next_w)
+
+        storage = cutlass.utils.SmemAllocator().allocate(self.shared_storage)
+        tx = (
+            2 * cute.size_in_bytes(BF16, cute.slice_(x_l, (None, None, 0)))
+            + cute.size_in_bytes(BF16, cute.slice_(b_l, (None, None, 0)))
+            + cute.size_in_bytes(BF16, cute.slice_(next_w_l, (None, None, 0)))
+        )
+        ring = pipeline.PipelineTmaAsync.create(
+            barrier_storage=storage.mbar.data_ptr(),
+            num_stages=self.stages,
+            producer_group=pipeline.CooperativeGroup(pipeline.Agent.Thread),
+            consumer_group=pipeline.CooperativeGroup(pipeline.Agent.Thread, 4),
+            tx_count=tx,
+            cta_layout_vmnk=cute.make_layout((1, 1, 1, 1)),
+        )
+        sX = storage.s_x.get_tensor(x_l.outer, swizzle=x_l.inner)
+        sB = storage.s_b.get_tensor(b_l.outer, swizzle=b_l.inner)
+        sY = storage.s_y.get_tensor(y_l.outer, swizzle=y_l.inner)
+        sS = storage.s_s.get_tensor(s_l.outer, swizzle=s_l.inner)
+        sW = storage.s_w.get_tensor(cute.make_layout(self.Hc))
+        sRho = storage.s_rho.get_tensor(cute.make_layout(BLK_M))
+        tXs, tXg = cpasync.tma_partition(
+            tma_x,
+            0,
+            cute.make_layout(1),
+            cute.group_modes(sX, 0, 2),
+            cute.group_modes(cute.local_tile(mX, (BLK_M, BLK_H), (None, None)), 0, 2),
+        )
+        sResidual = storage.s_residual.get_tensor(x_l.outer, swizzle=x_l.inner)
+        tRs, tRg = cpasync.tma_partition(
+            tma_residual,
+            0,
+            cute.make_layout(1),
+            cute.group_modes(sResidual, 0, 2),
+            cute.group_modes(
+                cute.local_tile(mResidual, (BLK_M, BLK_H), (None, None)), 0, 2
+            ),
+        )
+        sNextW = storage.s_next_w.get_tensor(next_w_l.outer, swizzle=next_w_l.inner)
+        tNextWs, tNextWg = cpasync.tma_partition(
+            tma_next_w,
+            0,
+            cute.make_layout(1),
+            cute.group_modes(sNextW, 0, 2),
+            cute.group_modes(
+                cute.local_tile(mNextW, (self.R, BLK_H), (None, None)), 0, 2
+            ),
+        )
+        tBs, tBg = cpasync.tma_partition(
+            tma_b,
+            0,
+            cute.make_layout(1),
+            cute.group_modes(sB, 0, 2),
+            cute.group_modes(cute.local_tile(mGD, (BLK_H, self.R), (None, None)), 0, 2),
+        )
+        tYs, tYg = cpasync.tma_partition(
+            tma_y,
+            0,
+            cute.make_layout(1),
+            cute.group_modes(sY, 0, 2),
+            cute.group_modes(cute.local_tile(mY, (BLK_M, BLK_H), (None, None)), 0, 2),
+        )
+
+        # CuTe DSL user objects must be constructed outside dynamic warp-role guards.
+        w = wg_idx - 1
+        ct = tidx - WG
+        wt = tidx % WG
+        all_bar = pipeline.NamedBarrier(barrier_id=1, num_threads=2 * WG)
+        wg_bar_id = 2 + w
+        thr = mma.get_slice(wt)
+        tCrA = mma.make_fragment_A(thr.partition_A(sS))
+        tCrB = mma.make_fragment_B(thr.partition_B(sB))
+        acc = thr.make_fragment_C(thr.partition_shape_C((BLK_M, BLK_H)))
+        tCc = thr.partition_C(cute.make_identity_tensor((BLK_M, BLK_H)))
+        next_thr = next_mma.get_slice(wt)
+        # The row-major BF16 output is SW128, as is the next F1's K-major A.
+        tNextA = next_mma.make_fragment_A(next_thr.partition_A(sY))
+        tNextB = next_mma.make_fragment_B(next_thr.partition_B(sNextW))
+        next_acc = next_thr.make_fragment_C(next_thr.partition_shape_C((BLK_M, self.R)))
+        tNextCc = next_thr.partition_C(cute.make_identity_tensor((BLK_M, self.R)))
+        next_num_k = cute.size(tNextA, mode=[2])
+        next_red_stride = BLK_M * self.R // WG + 1
+        sNextRed = storage.s_next_red.get_tensor(cute.make_layout(WG * next_red_stride))
+        next_row = wt // 2
+        next_col = (wt % 2) * (BLK_H // 2)
+        s2r = cute.make_tiled_copy_C(
+            cute.make_copy_atom(
+                warp.LdMatrix8x8x16bOp(transpose=False, num_matrices=4), BF16
+            ),
+            mma,
+        )
+        s2r_thr = s2r.get_slice(wt)
+        tSX = s2r_thr.partition_S(sX)
+        rX = cute.make_rmem_tensor_like(acc, BF16)
+        vX = s2r_thr.retile(rX)
+        r2s = cute.make_tiled_copy_C(sm90_utils.get_smem_store_op(ROW, BF16, F32), mma)
+        tRS_s = r2s.get_slice(wt).partition_D(sY)
+        r_out = cute.make_rmem_tensor_like(acc, BF16)
+        tSResidual = s2r_thr.partition_S(sResidual)
+        tRS_b = r2s.retile(r_out)
+        store_ring = pipeline.PipelineTmaStore.create(
+            num_stages=self.epi_stage,
+            producer_group=pipeline.CooperativeGroup(pipeline.Agent.Thread, WG),
+        )
+        cons = pipeline.make_pipeline_state(
+            pipeline.PipelineUserType.Consumer, self.stages
+        )
+        sr = ct // 4
+        sk0 = (ct % 4) * 4
+        pv = cute.make_rmem_tensor((4,), F32)
+        n_store = cutlass.Int32(0)
+        if wg_idx == 0:
+            cute.arch.setmaxregister_decrease(40)
+            if warp_idx == 0:
+                # x does not depend on F1: the producer starts while F1 is still running
+                prod = pipeline.make_pipeline_state(
+                    pipeline.PipelineUserType.Producer, self.stages
+                )
+                tile = cutlass.Int64(bidx)
+                while tile < num_tiles:
+                    bm = tile // self.n_hc
+                    h_base = (tile % self.n_hc) * self.n_sub
+                    for j in range(self.n_sub):
+                        ring.producer_acquire(prod)
+                        bar = ring.producer_get_barrier(prod)
+                        cute.copy(
+                            tma_x,
+                            tXg[(None, bm, h_base + j)],
+                            tXs[(None, prod.index)],
+                            tma_bar_ptr=bar,
+                        )
+                        cute.copy(
+                            tma_b,
+                            tBg[(None, h_base + j, 0)],
+                            tBs[(None, prod.index)],
+                            tma_bar_ptr=bar,
+                        )
+                        cute.copy(
+                            tma_residual,
+                            tRg[(None, bm, h_base + j)],
+                            tRs[(None, prod.index)],
+                            tma_bar_ptr=bar,
+                        )
+                        cute.copy(
+                            tma_next_w,
+                            tNextWg[(None, 0, h_base + j)],
+                            tNextWs[(None, prod.index)],
+                            tma_bar_ptr=bar,
+                        )
+                        ring.producer_commit(prod)
+                        prod.advance()
+                    tile += gdim
+                ring.producer_tail(prod)
+        if wg_idx != 0:
+            cute.arch.setmaxregister_increase(232)
+            cute.arch.griddepcontrol_wait()  # F1 partials; no-op without PDL
+            mma.set(cute.nvgpu.warpgroup.Field.ACCUMULATE, False)
+            next_mma.set(cute.nvgpu.warpgroup.Field.ACCUMULATE, True)
+
+            for _ in cutlass.range(w, unroll=1):
+                cons.advance()
+
+            tile = cutlass.Int64(bidx)
+            while tile < num_tiles:
+                bm = tile // self.n_hc
+                bc = tile % self.n_hc
+                m0 = bm * BLK_M
+                all_bar.arrive_and_wait()  # previous tile's sS / sW / sRho readers done
+                # ---- reduce the split-K partials: rho, P, S = silu(P) ----
+                m = m0 + sr
+                ss = F32(0.0)
+                pv.fill(0.0)
+                if m < M:
+                    for s in cutlass.range_constexpr(self.S):
+                        ss += mSSp[(s, m)]
+                        for kk in cutlass.range_constexpr(4):
+                            pv[kk] += mPp[(s, m, sk0 + kk)]
+                rho = cute.math.rsqrt(ss * self.inv_h + self.eps)
+                for kk in cutlass.range_constexpr(4):
+                    pk = pv[kk] * rho
+                    pv[kk] = pk
+                    sS[(sr, sk0 + kk, 0)] = BF16(pk * sigmoid(pk))
+                if sk0 == 0:
+                    sRho[sr] = rho * self.lgw
+                if bc == 0:
+                    if m < M:
+                        for kk in cutlass.range_constexpr(4):
+                            mP[(m, sk0 + kk)] = pv[kk]
+                        if sk0 == 0:
+                            mRho[m] = rho
+                hc0 = bc * self.Hc
+                for i in cutlass.range_constexpr(-(-self.Hc // (2 * WG))):
+                    hw = i * 2 * WG + ct
+                    if hw < self.Hc:
+                        sW[hw] = mW[hc0 + hw]
+                cute.arch.fence_proxy(
+                    "async.shared", space="cta"
+                )  # sS visible to wgmma
+                all_bar.arrive_and_wait()
+
+                # Each F2 chunk covers two next-F1 splits. Preserve the split
+                # boundaries and the order of the two warpgroups within each split.
+                splits_per_chunk = self.S // self.n_hc
+                subtiles_per_wg = self.n_sub // (2 * splits_per_chunk)
+                for split in range(splits_per_chunk):
+                    next_acc.fill(0.0)
+                    next_ss = F32(0.0)
+                    for jj in range(subtiles_per_wg):
+                        j = (split * subtiles_per_wg + jj) * 2 + w
+                        ring.consumer_wait(cons)
+                        st = cons.index
+                        cute.nvgpu.warpgroup.fence()
+                        cute.gemm(
+                            mma,
+                            acc,
+                            tCrA[(None, None, 0, 0)],
+                            tCrB[(None, None, 0, st)],
+                            acc,
+                        )
+                        cute.nvgpu.warpgroup.commit_group()
+                        cute.copy(s2r, tSX[(None, None, None, st)], vX)
+                        cute.nvgpu.warpgroup.wait_group(0)
+                        for i in cutlass.range_constexpr(cute.size(acc)):
+                            crd = tCc[i]
+                            acc[i] = (
+                                F32(rX[i])
+                                * sRho[crd[0]]
+                                * sW[j * BLK_H + crd[1]]
+                                * sigmoid(acc[i])
+                            )
+                        cute.copy(s2r, tSResidual[(None, None, None, st)], vX)
+                        normalized = acc.load().to(BF16).to(F32)
+                        r_out.store((normalized + rX.load().to(F32)).to(BF16))
+                        buf = w * self.epi_stage + n_store % self.epi_stage
+                        cute.copy(r2s, tRS_b, tRS_s[(None, None, None, buf)])
+                        cute.arch.fence_proxy("async.shared", space="cta")
+                        cute.arch.barrier(barrier_id=wg_bar_id, number_of_threads=WG)
+                        # Both the next F1 and the TMA output store read this rounded tile.
+                        cute.nvgpu.warpgroup.fence()
+                        for kb in cutlass.range_constexpr(next_num_k):
+                            cute.gemm(
+                                next_mma,
+                                next_acc,
+                                tNextA[(None, None, kb, buf)],
+                                tNextB[(None, None, kb, st)],
+                                next_acc,
+                            )
+                        cute.nvgpu.warpgroup.commit_group()
+                        if warp_idx % 4 == 0:
+                            cute.copy(
+                                tma_y,
+                                tYs[(None, buf)],
+                                tYg[(None, bm, bc * self.n_sub + j)],
+                            )
+                            store_ring.producer_commit()
+                            store_ring.producer_acquire()
+                        ss_j = F32(0.0)
+                        for c in cutlass.range_constexpr(BLK_H // 2):
+                            yv = F32(sY[(next_row, next_col + c, buf)])
+                            ss_j += yv * yv
+                        next_ss += ss_j
+                        cute.nvgpu.warpgroup.wait_group(0)
+                        # The next GEMM reads its weight from the current input stage.
+                        ring.consumer_release(cons)
+                        cons.advance()
+                        cons.advance()
+                        cute.arch.barrier(barrier_id=wg_bar_id, number_of_threads=WG)
+                        n_store += 1
+                    next_ss = cute.arch.warp_reduction_sum(next_ss, threads_in_group=2)
+                    if w == 1:
+                        for i in cutlass.range_constexpr(next_red_stride - 1):
+                            sNextRed[wt * next_red_stride + i] = next_acc[i]
+                        sNextRed[wt * next_red_stride + next_red_stride - 1] = next_ss
+                    all_bar.arrive_and_wait()
+                    if w == 0:
+                        s = bc * splits_per_chunk + split
+                        for i in cutlass.range_constexpr(next_red_stride - 1):
+                            crd = tNextCc[i]
+                            if m0 + crd[0] < M:
+                                mNextPp[(s, m0 + crd[0], crd[1])] = (
+                                    next_acc[i] + sNextRed[wt * next_red_stride + i]
+                                )
+                        if wt % 2 == 0:
+                            if m0 + next_row < M:
+                                mNextSSp[(s, m0 + next_row)] = (
+                                    next_ss
+                                    + sNextRed[
+                                        wt * next_red_stride + next_red_stride - 1
+                                    ]
+                                )
+                    all_bar.arrive_and_wait()  # sNextRed can be reused for the next split.
+                tile += gdim
+            store_ring.producer_tail()
+
+
+def compile_norm_pair(H, R, eps, lgw, dev, sms):
+    """Compile residual F2 with the next F1 for the native Hopper tile and SM budget."""
+    if (H, R, sms) != (4096, 16, 116):
+        raise ValueError("Norm-pair prototype requires H4096, R16 and 116 SMs")
+    split_k, n_hc, stages = 8, 4, 9
+    m = cute.sym_int(width=64)
+    return compile_op(
+        ("f2_next_f1", H, R, eps, lgw, dev.index, sms),
+        lambda: GnFwdOutWithNextStats(
+            H, R, split_k, n_hc, eps, lgw, sms, stages, add_residual=True
+        ),
+        (
+            make_fake_compact_tensor(
+                BF16, (m, H), stride_order=(1, 0), assumed_align=16
+            ),
+            make_fake_compact_tensor(F32, (H,), stride_order=(0,), assumed_align=16),
+            make_fake_compact_tensor(
+                BF16, (H, R), stride_order=(1, 0), assumed_align=16
+            ),
+            make_fake_compact_tensor(
+                F32, (split_k, m, R), stride_order=(2, 1, 0), assumed_align=16
+            ),
+            make_fake_compact_tensor(
+                F32, (split_k, m), stride_order=(1, 0), assumed_align=4
+            ),
+            make_fake_compact_tensor(
+                BF16, (m, H), stride_order=(1, 0), assumed_align=16
+            ),
+            make_fake_compact_tensor(F32, (m,), stride_order=(0,), assumed_align=16),
+            make_fake_compact_tensor(
+                F32, (m, R), stride_order=(1, 0), assumed_align=16
+            ),
+            make_fake_compact_tensor(
+                BF16, (m, H), stride_order=(1, 0), assumed_align=16
+            ),
+            make_fake_compact_tensor(
+                BF16, (R, H), stride_order=(1, 0), assumed_align=16
