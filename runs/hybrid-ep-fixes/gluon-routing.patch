+@gluon.jit
+def _grouped_routing_metadata_kernel(
+    expert_ids,
+    weights,
+    routing_storage,
+    probability_storage,
+    num_tokens: gl.constexpr,
+    top_k: gl.constexpr,
+    num_experts: gl.constexpr,
+    block_tokens: gl.constexpr,
+):
+    # One warp owns each token row, with expert columns spread over its lanes.
+    layout: gl.constexpr = gl.BlockedLayout(
+        [1, num_experts // 32], [1, 32], [block_tokens, 1], [1, 0]
+    )
+    block = gl.program_id(0)
+    token = block.to(gl.int64) * block_tokens + gl.arange(
+        0, block_tokens, layout=gl.SliceLayout(1, layout)
+    )
+    expert = gl.arange(0, num_experts, layout=gl.SliceLayout(0, layout))
+    active = token < num_tokens
+    route = gl.full((block_tokens, num_experts), False, gl.int1, layout)
+    probability = gl.full((block_tokens, num_experts), 0.0, gl.float32, layout)
+    for slot in gl.static_range(top_k):
+        input_offset = token * top_k + slot
+        raw_id = gl.load(expert_ids + input_offset, mask=active, other=-1)
+        # Check both bounds before narrowing so a wide ID cannot alias an expert.
+        expert_id = gl.where(raw_id.to(gl.uint64) < num_experts, raw_id, -1).to(
+            gl.int32
+        )
+        score = gl.load(weights + input_offset, mask=active, other=0).to(gl.float32)
+        match = expert[None, :] == expert_id[:, None]
+        route = route | match
+        probability = gl.where(match, score[:, None], probability)
+
+    output_offset = token[:, None] * num_experts + expert[None, :]
+    gl.store(routing_storage + output_offset, route, mask=active[:, None])
+    gl.store(probability_storage + output_offset, probability, mask=active[:, None])
+    if block == 0:
+        gl.store(routing_storage + num_tokens * num_experts, False)
+        gl.store(probability_storage + num_tokens * num_experts, 0.0)
+
+
