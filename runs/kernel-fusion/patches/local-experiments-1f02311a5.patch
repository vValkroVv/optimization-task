+"""Fuse the compiled MLA sigmoid gate and CudaCherry's rowwise FP8 input format."""
+
+import torch
+import triton
+import triton.language as tl
+
+from torchtitan.ops.float8.fp8_tensor import Float8BlockwiseQTensor, InputLayoutType
+
+
+@triton.jit
+def _mla_gate_quantize(
+    attn,
+    logits,
+    quantized,
+    scales,
+    BATCH_STRIDE: tl.constexpr,
+    SEQ_STRIDE: tl.constexpr,
+    HEAD_STRIDE: tl.constexpr,
+    ROWS: tl.constexpr,
+):
+    # 2 * 4096 * 32 * 128 elements fit in int32. Input strides may differ.
+    token = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
+    head = tl.program_id(1)
+    dim = tl.arange(0, 128)
+    attn_row = (
+        (token // 4096).to(tl.int64) * BATCH_STRIDE
+        + (token % 4096).to(tl.int64) * SEQ_STRIDE
+        + head.to(tl.int64) * HEAD_STRIDE
+    )
+    row = token * 4096 + head * 128
+    value = tl.load(attn + attn_row[:, None] + dim[None, :]).to(tl.float32)
+    gate_logits = tl.load(logits + row[:, None] + dim[None, :]).to(tl.float32)
+    gate = tl.sigmoid(gate_logits)
+    value = (value * gate).to(tl.bfloat16).to(tl.float32)
+
+    max_abs = tl.max(tl.abs(value), axis=1)
+    scale = tl.maximum(tl.div_rn(max_abs, 448.0), 1.0e-30)
+    # Ceil to a power of two by discarding the rounded-up FP32 mantissa.
+    bits = scale.to(tl.int32, bitcast=True)
+    scale = ((bits + 0x007FFFFF) & 0x7F800000).to(tl.float32, bitcast=True)
+    value = value * (1.0 / scale[:, None])
+    tl.store(quantized + row[:, None] + dim[None, :], value)
+    tl.store(scales + head * 8192 + token, scale)
+
+
+def _allocate_operand(logits):
+    return (
+        logits.new_empty(logits.shape, dtype=torch.float8_e4m3fn),
+        logits.new_empty((32, 8192), dtype=torch.float32),
+    )
+
+
+@torch.library.custom_op(
+    "torchtitan::mla_gate_quantize", mutates_args=(), device_types="cuda"
+)
+def _quantize(
+    attention: torch.Tensor, logits: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor]:
+    data, scale = _allocate_operand(logits)
+    _mla_gate_quantize[(8192 // 8, 32)](
+        attention,
+        logits,
+        data,
+        scale,
+        *attention.stride()[:3],
+        ROWS=8,
+        num_warps=4,
+    )
+    return data, scale
+
+
+@_quantize.register_fake
+def _quantize_fake(attention, logits):
+    return _allocate_operand(logits)
+
+
+@torch._dynamo.allow_in_graph
+class MLAGateFP8(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, attention, logits):
+        ctx.save_for_backward(attention, logits)
+        data, scale = _quantize(attention, logits)
+        return Float8BlockwiseQTensor(
+            data,
+            scale,
+            torch.bfloat16,
+            InputLayoutType.ROWWISE,
+            1,
+            scale_block_first=True,
+        )
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        attention, logits = ctx.saved_tensors
+        # Recompute the FP32 sigmoid from the saved BF16 projection output.
+        # This avoids retaining the FP32 sigmoid between forward and backward.
+        grad = grad_output.reshape(attention.shape).float()
+        gate = logits.view(attention.shape).float().sigmoid()
+        d_attention = (grad * gate).to(attention.dtype)
+        d_logits = torch.ops.aten.sigmoid_backward(grad * attention.float(), gate)
+        return d_attention, d_logits.view(logits.shape).to(logits.dtype)
