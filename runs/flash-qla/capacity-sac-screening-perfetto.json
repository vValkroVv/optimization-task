    "busy_overlap": "WITH ordered AS (SELECT ts,ts+dur e,max(ts+dur) OVER(ORDER BY ts,ts+dur ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) prev FROM slice WHERE category IN ('kernel','gpu_memcpy','gpu_memset')), flags AS (SELECT *,CASE WHEN prev IS NULL OR ts>prev THEN 1 ELSE 0 END f FROM ordered), groups AS (SELECT *,sum(f) OVER(ORDER BY ts,e) g FROM flags), busy AS (SELECT min(ts) ts,max(e) e FROM groups GROUP BY g), waits AS (SELECT s.id,s.ts,s.dur,c.id conditional_id,CASE WHEN EXISTS(SELECT 1 FROM ancestor_slice(c.id) a WHERE a.name='CompiledFunctionBackward') THEN 'backward_recompute' ELSE 'forward' END phase FROM slice s JOIN slice c ON c.name='torchtitan::conditional_capacity_mask' WHERE s.name='cudaStreamSynchronize' AND EXISTS(SELECT 1 FROM ancestor_slice(s.id) a WHERE a.id=c.id)) SELECT w.phase,count(DISTINCT w.id) n, sum(max(0,min(w.ts+w.dur,b.e)-max(w.ts,b.ts)))/1e6 busy_intersection_ms FROM waits w LEFT JOIN busy b ON b.ts<w.ts+w.dur AND b.e>w.ts GROUP BY w.phase;",
