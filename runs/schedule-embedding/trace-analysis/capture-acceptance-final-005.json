    },
    "reason": "Correct two generic local-kernel overlap labels; add explicit UNESTABLISHED MTP-prefix ownership status and exact head_to_ffn_gap proxy definition. Reuse all accepted capture counts/flows/tails without new MCP queries."
  },
  "sql": {
    "census": "SELECT category,count(*) AS n,sum(dur) AS sum_ns FROM slice GROUP BY category ORDER BY category",
    "scopes": "SELECT id,name,ts,dur,track_id,parent_id,category FROM slice WHERE category IN ('user_annotation','cpu_op','gpu_user_annotation') AND (name GLOB '*OwnerLookup*' OR name GLOB '*CompiledFunctionBackward*' OR name GLOB '*FSDP::*' OR name GLOB 'task.profile_update*' OR name GLOB '*embedding_dense_backward*') ORDER BY ts",
    "flows": "SELECT count(*) AS endpoints,count(DISTINCT k.id) AS distinct_device,sum(CASE WHEN extract_arg(k.arg_set_id,'args.correlation')=extract_arg(h.arg_set_id,'args.correlation') THEN 1 ELSE 0 END) AS matching_correlation FROM slice k JOIN flow f ON f.slice_in=k.id JOIN slice h ON h.id=f.slice_out WHERE k.category IN ('kernel','gpu_memcpy','gpu_memset')",
    "errors": "SELECT name,value,severity FROM stats WHERE value<>0 AND (severity='error' OR name GLOB '*drop*')",
    "device": "SELECT k.id,k.name,k.ts,k.dur,k.category,extract_arg(k.arg_set_id,'args.stream') AS stream,h.id AS launch_id,h.ts AS launch_ts,h.name AS launch_name,(SELECT group_concat(a.id||':'||a.name,' > ') FROM ancestor_slice(h.id) a) AS ancestors,extract_arg(k.arg_set_id,'args.In msg nelems') AS input_elements,extract_arg(k.arg_set_id,'args.Out msg nelems') AS output_elements,extract_arg(k.arg_set_id,'args.dtype') AS dtype,extract_arg(k.arg_set_id,'args.Group size') AS group_size,extract_arg(k.arg_set_id,'args.Seq') AS sequence FROM slice k LEFT JOIN flow f ON f.slice_in=k.id LEFT JOIN slice h ON h.id=f.slice_out WHERE k.category IN ('kernel','gpu_memcpy','gpu_memset') ORDER BY k.ts",
    "owner_host_waits": "SELECT o.id AS owner_scope,o.name AS owner_name,s.name,count(*) AS n,sum(s.dur)/1e6 AS host_span_ms FROM slice o JOIN slice s ON s.track_id=o.track_id AND s.ts>=o.ts AND s.ts<o.ts+o.dur WHERE o.name IN ('_OwnerLookup','_OwnerLookupBackward') AND s.category IN ('cuda_runtime','cuda_driver') AND (s.name GLOB '*Synchronize*' OR s.name GLOB '*Memcpy*' OR s.name GLOB '*WaitEvent*') GROUP BY 1,2,3 ORDER BY 1,3",
    "host": "SELECT name,count(*) AS n,sum(dur)/1e6 AS sum_ms,max(dur)/1e6 AS max_ms FROM slice WHERE category IN ('cuda_runtime','cuda_driver') GROUP BY name ORDER BY sum(dur) DESC",
    "annotations": "SELECT name,count(*) n,sum(dur)/1e6 sum_ms FROM slice WHERE category='user_annotation' GROUP BY name ORDER BY sum(dur) DESC",
    "host_window": "SELECT s.id,s.name,s.ts,s.dur,s.category FROM slice s WHERE s.category IN ('cuda_runtime','cuda_driver') AND (s.name GLOB '*Synchronize*' OR s.name GLOB '*Memcpy*' OR s.name GLOB '*WaitEvent*') ORDER BY ts",
    "host_micro": "SELECT m.id,m.ts,m.dur,s.name,count(*) n,sum(s.dur)/1e6 sum_ms FROM slice m JOIN slice s ON s.ts>=m.ts AND s.ts<m.ts+m.dur WHERE m.category='user_annotation' AND m.name GLOB 'task.profile_update*microbatch*' AND s.category IN ('cuda_runtime','cuda_driver') GROUP BY m.id,s.name",
    "gpu_annotations": "SELECT id,name,ts,dur,extract_arg(arg_set_id,'args.stream') AS stream FROM slice WHERE category='gpu_user_annotation' ORDER BY ts",
    "device_pages": [
      "SELECT k.id,k.name,k.ts,k.dur,k.category,extract_arg(k.arg_set_id,'args.stream') AS stream,h.id AS launch_id,h.ts AS launch_ts,h.name AS launch_name,(SELECT group_concat(a.id||':'||a.name,' > ') FROM ancestor_slice(h.id) a) AS ancestors,extract_arg(k.arg_set_id,'args.In msg nelems') AS input_elements,extract_arg(k.arg_set_id,'args.Out msg nelems') AS output_elements,extract_arg(k.arg_set_id,'args.dtype') AS dtype,extract_arg(k.arg_set_id,'args.Group size') AS group_size,extract_arg(k.arg_set_id,'args.Seq') AS sequence FROM slice k LEFT JOIN flow f ON f.slice_in=k.id LEFT JOIN slice h ON h.id=f.slice_out WHERE k.category IN ('kernel','gpu_memcpy','gpu_memset') ORDER BY k.ts LIMIT 4000 OFFSET 0",
      "SELECT k.id,k.name,k.ts,k.dur,k.category,extract_arg(k.arg_set_id,'args.stream') AS stream,h.id AS launch_id,h.ts AS launch_ts,h.name AS launch_name,(SELECT group_concat(a.id||':'||a.name,' > ') FROM ancestor_slice(h.id) a) AS ancestors,extract_arg(k.arg_set_id,'args.In msg nelems') AS input_elements,extract_arg(k.arg_set_id,'args.Out msg nelems') AS output_elements,extract_arg(k.arg_set_id,'args.dtype') AS dtype,extract_arg(k.arg_set_id,'args.Group size') AS group_size,extract_arg(k.arg_set_id,'args.Seq') AS sequence FROM slice k LEFT JOIN flow f ON f.slice_in=k.id LEFT JOIN slice h ON h.id=f.slice_out WHERE k.category IN ('kernel','gpu_memcpy','gpu_memset') ORDER BY k.ts LIMIT 4000 OFFSET 4000",
      "SELECT k.id,k.name,k.ts,k.dur,k.category,extract_arg(k.arg_set_id,'args.stream') AS stream,h.id AS launch_id,h.ts AS launch_ts,h.name AS launch_name,(SELECT group_concat(a.id||':'||a.name,' > ') FROM ancestor_slice(h.id) a) AS ancestors,extract_arg(k.arg_set_id,'args.In msg nelems') AS input_elements,extract_arg(k.arg_set_id,'args.Out msg nelems') AS output_elements,extract_arg(k.arg_set_id,'args.dtype') AS dtype,extract_arg(k.arg_set_id,'args.Group size') AS group_size,extract_arg(k.arg_set_id,'args.Seq') AS sequence FROM slice k LEFT JOIN flow f ON f.slice_in=k.id LEFT JOIN slice h ON h.id=f.slice_out WHERE k.category IN ('kernel','gpu_memcpy','gpu_memset') ORDER BY k.ts LIMIT 4000 OFFSET 8000"
    ],
    "tail": "SELECT s.id,s.name,s.ts,s.dur,s.category,extract_arg(s.arg_set_id,'args.correlation') AS correlation,(SELECT count(*) FROM flow f WHERE f.slice_out=s.id) AS device_links FROM slice s WHERE s.category IN ('cuda_runtime','cuda_driver') AND (s.name GLOB '*Launch*' OR s.name GLOB '*Memcpy*' OR s.name GLOB '*Memset*' OR s.name GLOB '*Synchronize*') ORDER BY s.ts",
    "owner_host": "SELECT o.id AS owner_scope,o.name AS owner_name,s.category,s.name,count(*) AS n,sum(s.dur)/1e6 AS sum_ms FROM slice o JOIN slice s ON s.track_id=o.track_id AND s.ts>=o.ts AND s.ts+s.dur<=o.ts+o.dur WHERE o.name IN ('_OwnerLookup','_OwnerLookupBackward') GROUP BY 1,2,3,4 ORDER BY 1,3,4",
    "bounds": "SELECT start_ts,end_ts FROM trace_bounds",
    "tail_pages": [
      "SELECT s.id,s.name,s.ts,s.dur,s.category,extract_arg(s.arg_set_id,'args.correlation') AS correlation,(SELECT count(*) FROM flow f WHERE f.slice_out=s.id) AS device_links FROM slice s WHERE s.category IN ('cuda_runtime','cuda_driver') AND (s.name GLOB '*Launch*' OR s.name GLOB '*Memcpy*' OR s.name GLOB '*Memset*' OR s.name GLOB '*Synchronize*') ORDER BY s.ts LIMIT 4000 OFFSET 0",
      "SELECT s.id,s.name,s.ts,s.dur,s.category,extract_arg(s.arg_set_id,'args.correlation') AS correlation,(SELECT count(*) FROM flow f WHERE f.slice_out=s.id) AS device_links FROM slice s WHERE s.category IN ('cuda_runtime','cuda_driver') AND (s.name GLOB '*Launch*' OR s.name GLOB '*Memcpy*' OR s.name GLOB '*Memset*' OR s.name GLOB '*Synchronize*') ORDER BY s.ts LIMIT 4000 OFFSET 4000",
      "SELECT s.id,s.name,s.ts,s.dur,s.category,extract_arg(s.arg_set_id,'args.correlation') AS correlation,(SELECT count(*) FROM flow f WHERE f.slice_out=s.id) AS device_links FROM slice s WHERE s.category IN ('cuda_runtime','cuda_driver') AND (s.name GLOB '*Launch*' OR s.name GLOB '*Memcpy*' OR s.name GLOB '*Memset*' OR s.name GLOB '*Synchronize*') ORDER BY s.ts LIMIT 4000 OFFSET 8000"
    ]
  },
