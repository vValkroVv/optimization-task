+"""CUDA writers for the experimental FP32 LM-head reduce-scatter input."""
+
+import ctypes as c
+import logging
+import weakref
+from collections import OrderedDict
+from contextlib import ExitStack
+from dataclasses import dataclass
+
+import torch
+
+
+logger = logging.getLogger("gfsdp")
+
+
+class _CublasGemmEx:
+    name = "cublasGemmEx"
+
+    def __init__(self) -> None:
+        lib = c.CDLL("libcublas.so.13")
+        self.gemm = lib.cublasGemmEx
+        self.gemm.argtypes = [
+            _Ptr,
+            _Int,
+            _Int,
+            _Int,
+            _Int,
+            _Int,
+            _Ptr,
+            _Ptr,
+            _Int,
+            _Int,
+            _Ptr,
+            _Int,
+            _Int,
+            _Ptr,
+            _Ptr,
+            _Int,
+            _Int,
+            _Int,
+            _Int,
+        ]
+        self.gemm.restype = _Int
+        self.pointer_mode = lib.cublasGetPointerMode_v2
+        self.pointer_mode.argtypes = [_Ptr, c.POINTER(_Int)]
+        self.pointer_mode.restype = _Int
+        self.checked_handles: set[int] = set()
+
+    def __call__(self, grad, hidden, slot, add, stream) -> None:
+        # The row-major [V,H] destination is [H,V] to column-major cuBLAS.
+        rows, vocab = grad.shape
+        width = hidden.shape[1]
+        handle = torch.cuda.current_blas_handle()
+        if handle not in self.checked_handles:
+            mode = _Int()
+            _check(self.pointer_mode, handle, c.byref(mode))
+            if mode.value != 0:
+                raise RuntimeError(
+                    "Direct LM-head dW requires host cuBLAS pointer mode"
+                )
+            self.checked_handles.add(handle)
+        _check(
+            self.gemm,
+            handle,
+            _OP_N,
+            _OP_T,
+            width,
+            vocab,
+            rows,
+            c.byref(_ONE),
+            hidden.data_ptr(),
+            _BF16,
+            width,
+            grad.data_ptr(),
+            _BF16,
+            vocab,
+            c.byref(_BETA[add]),
+            slot.data_ptr(),
+            _FP32,
+            width,
+            _COMPUTE_32F,
+            _GEMM_DEFAULT,
+        )
+
+
+_Ptr, _Int, _U64, _Size = c.c_void_p, c.c_int, c.c_uint64, c.c_size_t
+_OP_N, _OP_T = 0, 1
+_BF16, _FP32, _COMPUTE_32F, _GEMM_DEFAULT = 14, 0, 68, -1
+_TRANS_A, _TRANS_B, _LAYOUT_ORDER = 3, 4, 1
+_ROW_MAJOR = 1
+_ONE = c.c_float(1)
+_BETA = (c.c_float(0), _ONE)
+_Algo = _U64 * 8
+_CUBLAS_LT_VERSION = 130101
+_PREF_MAX_WORKSPACE_BYTES = 1
+_PREF_REDUCTION_SCHEME_MASK = 3
+_PREF_MIN_ALIGNMENT_A_BYTES = 5
+_FP32_REDUCTION_SCHEMES = 1 | 2  # In-place FP32 output or FP32 compute type.
+_WORKSPACE_LIMIT_BYTES = 32 * 1024 * 1024
+_ALGO_CONFIG_ID, _ALGO_CONFIG_TILE_ID = 0, 1
+_MAX_CACHED_PLANS = 8
+
+
+class _HeuristicResult(c.Structure):
+    _fields_ = [
+        ("algo", _Algo),
+        ("workspace_bytes", _Size),
+        ("state", _Int),
+        ("waves", c.c_float),
+        ("reserved", _Int * 4),
+    ]
+
+
+# Selected beta=0/beta=1 entries in frontier-dw/tune-{2,8}.json.
+# These are the serialized cuBLASLt 13.1.1 H100 algorithms, with 4 B workspace.
+_ALGO_5_5 = (
+    "5.5",
+    False,
+    (
+        "420000001d000000230000000100000000000000000000000100000000000300"
+        "0100000035fc01000e0000000e00000000000000440000000000000000000000",
+    )
+    * 2,
+)
+_LT_ALGOS = {
+    2: (
+        "9.14",
+        True,
+        (
+            "4200000018000000230000000100000000000000000000000700000000000500"
+            "0100000035fc01000e0000000e00000000000000440000000000000000000000",
+            "42000000ef010000230000000100000000000000000000000700000000000500"
+            "0100000035fc01000e0000000e00000000000000440000000000000000000000",
+        ),
+    ),
+    8: _ALGO_5_5,
+    # This plan was also verified with both beta values on the 512-row C32 chunk.
+    32: _ALGO_5_5,
+}
+
+
+def _check(fn, *args) -> None:
+    if status := fn(*args):
+        raise RuntimeError(f"{fn.__name__} returned CUDA BLAS status {status}")
+
+
+def _set_attribute(fn, descriptor, key, value):
+    _check(fn, descriptor, key, c.byref(value), c.sizeof(value))
+
+
+@dataclass
+class _MatmulLayout:
+    operation: _Ptr
+    a: _Ptr
+    b: _Ptr
+    cd: _Ptr
+    row_major: bool
+
+
+@dataclass
+class _MatmulPlan:
+    layout: _MatmulLayout
+    algorithms: tuple[_Algo, _Algo]
+    workspace_bytes: int
+    resources: ExitStack
+
+
+class _CublasLtMatmul:
+    name = "cublasLtMatmul"
+
+    def __init__(
+        self,
+        chunks: int | None,
+        rows: int,
+        vocab: int,
+        width: int,
+        stream: torch.Stream,
+    ) -> None:
+        if chunks is None:
+            cuda_version = torch.version.cuda
+            if cuda_version is None:
+                raise RuntimeError("Direct cuBLASLt LM-head dW requires a CUDA build")
+            soname = f"libcublasLt.so.{cuda_version.split('.')[0]}"
+        else:
+            soname = "libcublasLt.so.13"
+        lib = c.CDLL(soname)
+
+        def bind(name, *args, result=_Int):
+            fn = getattr(lib, "cublasLt" + name)
+            fn.argtypes, fn.restype = list(args), result
+            return fn
+
+        self.version = bind("GetVersion", result=_Size)()
+        if chunks is not None and self.version != _CUBLAS_LT_VERSION:
+            raise RuntimeError(
+                "Direct LM-head dW requires the tuned cuBLASLt 13.1.1 build "
+                f"({_CUBLAS_LT_VERSION}), got {self.version}"
+            )
+
+        self.stream = stream
+        create = bind("Create", _Ptr)
+        destroy = bind("Destroy", _Ptr)
+        self.desc_create = bind("MatmulDescCreate", _Ptr, _Int, _Int)
+        self.desc_destroy = bind("MatmulDescDestroy", _Ptr)
+        self.desc_attr = bind("MatmulDescSetAttribute", _Ptr, _Int, _Ptr, _Size)
+        self.layout_create = bind(
+            "MatrixLayoutCreate", _Ptr, _Int, _U64, _U64, c.c_int64
+        )
