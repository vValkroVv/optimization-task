#!/bin/bash
{% if job_desc %}
#SBATCH --job-name="{{job_desc}}"
{% endif %}
#SBATCH --nodes={{n_workers}}
#SBATCH --ntasks-per-node={{ processes_per_worker }}
#SBATCH --gres=gpu:{{ gpu_num }}
#SBATCH --gpus-per-node={{ gpu_num }}
#SBATCH --exclusive
#SBATCH --partition={{ partition }}
#SBATCH --output={{slurm_logdir}}/%j/logs.log
#SBATCH --error={{slurm_logdir}}/%j/logs.err
{% if max_restarts %}
#SBATCH --requeue
{% endif %}
{% if nodelist %}
## <!-- Code to execute if value is specified -->
#SBATCH --nodelist={{nodelist}}
{% endif %}
{% if cpus_per_task %}
#SBATCH --cpus-per-task={{ cpus_per_task }}
{% endif %}

set -evx

MOUNTS="{{nfs_path}}"
CONTAINER_IMAGE="{{ base_image }}"

LOGDIR_BASE="{{ job_logdir }}"

slurm_startup_script=$(cat << EOF
export NNODES=\$SLURM_NNODES
export GPUS_PER_NODE=\$SLURM_GPUS_ON_NODE

umask 0002;
ulimit -n 131072;
echo "hi from \$(hostname)"

{# all envs will be overrided #}
{% if env_variables %}{% for key, value in env_variables.items() %}
export {{key}}="{{value}}"
{% endfor %}{% endif %}

LOGDIR="$LOGDIR_BASE/\$SLURM_JOB_ID/retry_\${SLURM_RESTART_COUNT:-0}"

mkdir -p \$LOGDIR

export NODE_RANK=\$SLURM_PROCID

echo \$(env) > \$LOGDIR/\$SLURM_PROCID.env

echo \$(nvidia-smi) > \$LOGDIR/\$SLURM_PROCID.nvidia_smi

{
    {{ script }}
} > "\$LOGDIR/log_\${SLURM_PROCID}.txt" 2>&1

exit_code=\$?

exit \$exit_code
EOF
)

set +e

# download images to nodes
srun --container-image="$CONTAINER_IMAGE" \
     --no-container-mount-home \
     --container-name="$(basename $CONTAINER_IMAGE)" \
     --container-mounts="$MOUNTS:$MOUNTS{% if extra_mounts %},{{ extra_mounts }}{% endif %}" \
     --container-workdir="$MOUNTS" \
     true

# run scripts
srun --container-name="$(basename $CONTAINER_IMAGE)" \
     --no-container-mount-home \
     --container-mounts="$MOUNTS:$MOUNTS{% if extra_mounts %},{{ extra_mounts }}{% endif %}" \
     --container-workdir="$MOUNTS" \
     -K \
     bash -c "$slurm_startup_script"

exitcode=$?
set -e
echo "job exited with code $exitcode"

{% if max_restarts %}
if [ $exitcode -ne 0 ]; then
    if [ "{{max_restarts}}" -gt "${SLURM_RESTART_COUNT:-0}" ]; then
        echo "Program execution failed" >&2
        scontrol requeue "$SLURM_JOB_ID"
    fi
    exit $exitcode
fi
{% endif %}