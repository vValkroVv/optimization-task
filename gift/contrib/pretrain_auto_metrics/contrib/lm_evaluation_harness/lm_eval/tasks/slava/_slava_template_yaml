
tag: slava_tasks
dataset_path: ai-sage/slava
validation_split: test
fewshot_split: test
num_fewshot: 5
output_type: generate_until
generation_kwargs:
  temperature: 0.0
  max_gen_toks: 500
  do_sample: false
  top_k: 1
  until:
    - "\n\n"
    - "\n"

doc_to_text: !function utils.doc_to_text
doc_to_target: "{{outputs}}"

process_results: !function utils.process_numeric_tasks

metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
  - metric: partially_match
    aggregation: mean
    higher_is_better: true
  - metric: contains_check
    aggregation: mean
    higher_is_better: true
  - metric: mean_score
    aggregation: mean
    higher_is_better: true

metadata:
    version: 1.0
