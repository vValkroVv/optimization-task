<clickhouse>
    <!-- The default user runs the summary loops. Over this cap (64 GB) a loop query fails and is retried, instead of
         the loops starving ingest and Grafana, which run as their own users. -->
    <profiles>
        <default>
            <max_memory_usage_for_user>64000000000</max_memory_usage_for_user>
        </default>
    </profiles>
</clickhouse>
