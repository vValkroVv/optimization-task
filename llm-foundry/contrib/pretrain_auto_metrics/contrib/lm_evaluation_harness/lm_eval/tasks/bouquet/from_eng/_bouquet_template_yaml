dataset_path: ai-sage/bouquet
test_split: test
fewshot_split: dev
num_fewshot: 5
output_type: generate_until
generation_kwargs:
  temperature: 0.0
  do_sample: false
  max_gen_toks: 200
  until:
    - "\n\n"

metric_list:
  - metric: chrf
    aggregation: !function utils.chrf_norm
    higher_is_better: true
  - metric: !function utils.chrf_sent
    aggregation: mean
    higher_is_better: true

metadata:
  version: 1.0
doc_to_target: "{{src_text.strip()}}"
tag:
  - bouquet_tasks
  - bouquet_from_eng_tasks