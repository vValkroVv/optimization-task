dataset_path: ai-sage/ru_culture_code
test_split: test
fewshot_split: fewshot
fewshot_config:
  sampler: first_n
  doc_to_text: !function utils.fewshot_to_text
  doc_to_target: !function utils.fewshot_to_target
num_fewshot: 3
output_type: generate_until
doc_to_text: !function utils.doc_to_text
doc_to_target: "{{answer}}"
process_results: !function utils.process_results
generation_kwargs:
  until:
    - "Задание:"
    - "Теперь ответь"
  do_sample: false
  temperature: 0.0
  max_gen_toks: 8192
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
