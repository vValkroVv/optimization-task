{
    "include": [
        "."
    ],
    "exclude": [
        "**/__pycache__",
        "**/.*",
        "**/node_modules"
    ],
    "venvPath": "/home/user/conda",
    "venv": "base",
    "pythonVersion": "3.11",
    "pythonPlatform": "Linux",
    "typeCheckingMode": "basic",
    "reportMissingImports": true,
    "reportMissingTypeStubs": false,
    "executionEnvironments": [
        {
            "root": ".",
            "pythonVersion": "3.11",
            "pythonPlatform": "Linux",
            "extraPaths": [
                "/home/user/conda/lib/python3.11/site-packages"
            ]
        }
    ]
}


