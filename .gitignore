# Local secrets; example templates remain trackable.
.env
.env.*
!.env.example
!.env.*.example

# Local tooling and caches.
.DS_Store
__pycache__/
*.py[cod]
.venv/

# Large run payloads belong outside Git. Keep concise reports and manifests trackable.
/runs/**/artifacts/checkpoints/
/runs/**/artifacts/datasets/
/runs/**/artifacts/profiles/
/runs/**/artifacts/traces/
/runs/**/artifacts/raw/
